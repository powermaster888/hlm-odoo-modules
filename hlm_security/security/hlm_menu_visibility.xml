<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide cost fields on product views for users without HLM Cost Visibility -->
    <record id="product_template_form_view_hide_cost" model="ir.ui.view">
        <field name="name">product.template.form.hide.cost.hlm</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="attributes">
                <attribute name="groups">hlm_security.group_hlm_cost_visibility</attribute>
            </field>
            <field name="lst_price" position="before">
                <field name="standard_price" groups="hlm_security.group_hlm_cost_visibility" invisible="not groups('hlm_security.group_hlm_cost_visibility')"/>
            </field>
        </field>
    </record>

    <!-- Hide stock report buttons for users in the Hide Stock Report Buttons group -->
    <record id="stock_picking_form_hide_report_buttons" model="ir.ui.view">
        <field name="name">stock.picking.form.hide.report.hlm</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_validate']" position="attributes">
                <attribute name="groups">!group_hlm_hide_stock_report_buttons_placeholder</attribute>
            </xpath>
        </field>
    </record>

    <!-- Top-level menu visibility: restrict main app menus by group membership.
         Show Menu Master gets everything; Show Menu User gets standard apps;
         Show Menu Salesperson gets sales/POS only. -->

    <!-- Accounting menu: only for users with Show Accounting Menu group -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('hlm_security.group_hlm_show_accounting_menu')), (4, ref('account.group_account_manager')), (4, ref('account.group_account_user'))]"/>
    </record>

    <!-- Inventory menu: base access via Show Menu User or Master -->
    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('hlm_security.group_hlm_show_menu_user')), (4, ref('hlm_security.group_hlm_show_menu_master')), (4, ref('stock.group_stock_manager')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <!-- Point of Sale: salesperson or user or master -->
    <record id="point_of_sale.menu_point_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('hlm_security.group_hlm_show_menu_salesperson')), (4, ref('hlm_security.group_hlm_show_menu_user')), (4, ref('hlm_security.group_hlm_show_menu_master'))]"/>
    </record>

    <!-- Sales: salesperson, user, or master -->
    <record id="sale.sale_menu_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('hlm_security.group_hlm_show_menu_salesperson')), (4, ref('hlm_security.group_hlm_show_menu_user')), (4, ref('hlm_security.group_hlm_show_menu_master'))]"/>
    </record>

    <!-- Purchase: user or master -->
    <record id="purchase.purchase_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('hlm_security.group_hlm_show_menu_user')), (4, ref('hlm_security.group_hlm_show_menu_master'))]"/>
    </record>

    <!-- Employees: user or master -->
    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('hlm_security.group_hlm_show_menu_user')), (4, ref('hlm_security.group_hlm_show_menu_master'))]"/>
    </record>

    <!-- Time Off: user or master -->
    <record id="hr_holidays.menu_hr_holidays_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('hlm_security.group_hlm_show_menu_user')), (4, ref('hlm_security.group_hlm_show_menu_master'))]"/>
    </record>

    <!-- Attendance: user or master -->
    <record id="hr_attendance.menu_hr_attendance_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('hlm_security.group_hlm_show_menu_user')), (4, ref('hlm_security.group_hlm_show_menu_master'))]"/>
    </record>

    <!-- Calendar: user or master -->
    <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('hlm_security.group_hlm_show_menu_user')), (4, ref('hlm_security.group_hlm_show_menu_master'))]"/>
    </record>
</odoo>
