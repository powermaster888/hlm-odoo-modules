        <!-- Menu visibility master switches -->
        <record id="group_hlm_show_menu_master" model="res.groups">
            <field name="name">Show Menu - Master</field>
        </record>
        <record id="group_hlm_show_menu_user" model="res.groups">
            <field name="name">Show Menu - User</field>
        </record>
        <record id="group_hlm_show_menu_salesperson" model="res.groups">
            <field name="name">Show Menu - Salesperson</field>
        </record>

        <!-- Per-app menu switches -->
        <record id="group_hlm_show_accounting_menu" model="res.groups">
            <field name="name">Show Accounting Menu</field>
        </record>
        <record id="group_hlm_show_appraisal_menu" model="res.groups">
            <field name="name">Show Appraisal Menu</field>
        </record>
        <record id="group_hlm_show_attendance_menu" model="res.groups">
            <field name="name">Show Attendance Menu</field>
        </record>
        <record id="group_hlm_show_calendar_menu" model="res.groups">
            <field name="name">Show Calendar Menu</field>
        </record>
        <record id="group_hlm_show_documents_menu" model="res.groups">
            <field name="name">Show Documents Menu</field>
        </record>
        <record id="group_hlm_show_employee_menu" model="res.groups">
            <field name="name">Show Employee Menu</field>
        </record>
        <record id="group_hlm_show_leave_menu" model="res.groups">
            <field name="name">Show Leave Menu</field>
        </record>
        <record id="group_hlm_show_payroll_menu" model="res.groups">
            <field name="name">Show Payroll Menu</field>
        </record>

        <!-- Business rules groups -->
        <record id="group_hlm_cost_visibility" model="res.groups">
            <field name="name">HLM Cost Visibility</field>
            <field name="comment">Allows seeing product cost fields (standard_price, etc.)</field>
        </record>
        <record id="group_hlm_mask_nonlocal_vendor" model="res.groups">
            <field name="name">Mask Non-local Vendor on WH/IN</field>
            <field name="comment">Masks non-local supplier info on warehouse incoming pickings</field>
        </record>
        <record id="group_hlm_hide_stock_report_buttons" model="res.groups">
            <field name="name">Hide Stock Report Buttons</field>
            <field name="comment">Hides stock report action buttons for non-privileged users</field>
        </record>
        <record id="group_hlm_vendor_bills_partner_button" model="res.groups">
            <field name="name">Allow Vendor Bills Partner Button</field>
            <field name="comment">Shows the partner button on vendor bills form</field>
        </record>
    </data>
