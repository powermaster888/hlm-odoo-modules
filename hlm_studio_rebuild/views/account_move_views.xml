<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_hlm_fields" model="ir.ui.view">
        <field name="name">account.move.form.hlm.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="hlm_pos_cashier" invisible="not hlm_pos_cashier"/>
                <field name="hlm_delivery_origin" invisible="not hlm_delivery_origin"/>
            </xpath>
        </field>
    </record>
</odoo>
